# Obrigatórias
APP_PASSWORD=
# Meta for Developers → seu app → Instagram → API setup with Instagram login → "Instagram app ID" / "Instagram app secret"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Supabase → Connect → "Session pooler" (funciona em IPv4). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# URL pública do app (usada no redirecionamento do login do Instagram)
APP_URL=https://instadm.seudominio.com

# Usados nas páginas públicas exigidas pela Meta (/privacy, /data-deletion, /terms)
LEGAL_OWNER=Seu nome (uso pessoal, não comercial)
LEGAL_EMAIL=contato@seudominio.com

# Opcionais
# POLL_SECONDS=20                          # intervalo de verificação
# MEDIA_LIMIT=12                           # quantos posts recentes monitorar
# MAX_SENDS_PER_HOUR=120                   # limite de 1ªs mensagens por hora, por conta (o excedente espera na fila)
# COOLDOWN_HOURS=24                        # não reenviar a mesma DM ao mesmo usuário
